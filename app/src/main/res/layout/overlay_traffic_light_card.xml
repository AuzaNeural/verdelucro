<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF"
    android:elevation="16dp">

    <!-- Linha 1: 4 Colunas (R$/km | R$/hora | Lucro | Lucro %) idêntico à Imagem 1 do GigU -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="4">

        <!-- Coluna 1: R$/km -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$/km"
                android:textColor="#757575"
                android:textSize="10sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:id="@+id/indicatorBarKm"
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:background="#00C853" />
                <TextView
                    android:id="@+id/txtRateKm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2,25"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Coluna 2: R$/hora -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$/hora"
                android:textColor="#757575"
                android:textSize="10sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:id="@+id/indicatorBarHour"
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:background="#00C853" />
                <TextView
                    android:id="@+id/txtRateHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="48,77"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Coluna 3: Lucro -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lucro"
                android:textColor="#757575"
                android:textSize="10sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:id="@+id/indicatorBarProfit"
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:background="#00C853" />
                <TextView
                    android:id="@+id/txtNetProfit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18,90"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Coluna 4: Lucro % -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lucro %"
                android:textColor="#757575"
                android:textSize="10sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <View
                    android:id="@+id/indicatorBarPercent"
                    android:layout_width="4dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="4dp"
                    android:background="#00C853" />
                <TextView
                    android:id="@+id/txtProfitPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="75%"
                    android:textColor="#111111"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Linha 2: Sub-informações (Plataforma, Duração, Distância e Dinâmico) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txtPlatformBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:text="Uber"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTripStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="0h31m • 11,2km"
            android:textColor="#424242"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSurgeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="#FFF3E0"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="⚡ 1.4x"
            android:textColor="#E65100"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#757575"
            android:contentDescription="Fechar" />
    </LinearLayout>

    <!-- Linha 3: Barra de Ações Rápidas Discretas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnOpenMaps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🗺️ Destino"
            android:textColor="#1976D2"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSecretCamera"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📹 Câmera"
            android:textColor="#C2185B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSpeak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔊 Voz"
            android:textColor="#388E3C"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
